# PostgreSQL connection string. On Vercel, this is set automatically when you
# add a Neon database from the Marketplace integration. Locally, paste your
# Neon (or other Postgres) connection string here.
DATABASE_URL="postgresql://user:password@host:5432/skillence?schema=public"

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"

# How long auth tokens last
JWT_EXPIRES_IN="7d"

# Comma-separated list of extra cross-origin frontends allowed to call the API.
# Same-origin requests (frontend+API on the same Vercel project) need nothing here.
# Use this only if you're hosting the static frontend on a different host during dev.
CORS_ORIGINS=""

# Port the standalone Express server listens on (only used by `npm run dev`,
# not by Vercel — Vercel sets PORT for its own process).
PORT=4000

# "development" or "production" — production sets Secure cookies and disables verbose logs
NODE_ENV="development"
